units			real
atom_style      full

boundary p p p

bond_style harmonic
angle_style harmonic
dihedral_style harmonic


pair_style lj/cut/coul/long 10
kspace_style ewald 1.0e-4


read_data 2x.data extra/bond/types 1 extra/angle/types 1


# Mock bond and angles
bond_coeff 2 0 5
angle_coeff 2 0 180


group mnfn type 1 2
group sodium type 3
group water type 4 5

region layer1 block INF INF INF INF 16 23
region layer2 block INF INF INF INF 9 15
region layer3 block INF INF INF INF 2 8
region layer4 block INF INF INF INF -5.5 1.5


group lr1 region layer1
group lr2 region layer2
group lr3 region layer3
group lr4 region layer4

group lr1parts intersect lr1 sodium
group lr2parts intersect lr2 sodium
group lr3parts intersect lr3 sodium
group lr4parts intersect lr4 sodium


comm_modify cutoff 15
variable ts equal step

compute 1 lr1parts hexorder/atom cutoff 5 nnn 3 degree 2
compute 2 lr2parts hexorder/atom cutoff 5 nnn 3 degree 2
compute 3 lr3parts hexorder/atom cutoff 5 nnn 3 degree 2
compute 4 lr4parts hexorder/atom cutoff 5 nnn 3 degree 2

compute 1re lr1parts reduce ave c_1[1]
compute 2re lr2parts reduce ave c_2[1]
compute 3re lr3parts reduce ave c_3[1]
compute 4re lr4parts reduce ave c_4[1]

variable v1re equal c_1re
variable v2re equal c_2re
variable v3re equal c_3re
variable v4re equal c_4re

compute 1im lr1parts reduce ave c_1[2]
compute 2im lr2parts reduce ave c_2[2]
compute 3im lr3parts reduce ave c_3[2]
compute 4im lr4parts reduce ave c_4[2]

variable v1im equal c_1im
variable v2im equal c_2im
variable v3im equal c_3im
variable v4im equal c_4im



dump 1 lr1parts custom 1000 anglesl1.dump id type c_1[*]
dump 2 lr2parts custom 1000 anglesl2.dump id type c_2[*]
dump 3 lr3parts custom 1000 anglesl3.dump id type c_3[*]
dump 4 lr4parts custom 1000 anglesl4.dump id type c_4[*]


fix extra all print 1000 "${ts}, ${v1re}, ${v1im}, ${v2re}, ${v2im}, ${v3re}, ${v3im}, ${v4re}, ${v4im}" file angles7_dump.txt title "t l1re l1im l2re l2im l3re l3im l4re l4im"

rerun 2x_7_4z_ef_0.02_r1.dump first 10000 dump x y z



#plot "angles_dump.txt" u 1:2 w l, "angles_dump.txt" u 1:3 w l, "angles_dump.txt" u 1:(abs($2)+abs($3)) w l